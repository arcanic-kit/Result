<Project>

  <!-- Central package management: versions are declared here, projects reference packages without a Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!-- Samples -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
