<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Arcanic.Result</PackageId>
    <Description>A robust Result pattern implementation for .NET applications inspired by functional programming principles</Description>
    <PackageTags>result;result-pattern;functional;error-handling;railway-oriented;dotnet</PackageTags>
  </PropertyGroup>

  <!-- Version used by local and PR builds; the release workflow overrides it with the tag version.
       After each release: set VersionPrefix to the next version and the baseline to the one just shipped. -->
  <PropertyGroup>
    <VersionPrefix>10.0.1</VersionPrefix>
  </PropertyGroup>

  <!-- Fail pack on breaking API changes against the last published version,
       and on API differences between target frameworks. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>10.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
